{
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*"
    ],
    "modules-left": [
        "group/pill#left2"
    ],
    "group/pill#left2": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "modules": [
            "idle_inhibitor",
            "clock"
        ],
        "orientation": "inherit"
    },
    "modules-right": [
        "group/pill#keepass",
        "group/pill#obs",
        "group/pill#right1"
    ],
    "group/pill#keepass": {
        "modules": [
            "custom/keepass"
        ],
        "orientation": "inherit"
    },
    "group/pill#obs": {
        "modules": [
            "custom/obs"
        ],
        "orientation": "inherit"
    },
    "group/pill#right1": {
        "modules": [
            "network",
            "pulseaudio",
            "pulseaudio#microphone",
            "custom/updates",
            "custom/keybindhint",
            "tray",
            "custom/power"
        ],
        "orientation": "inherit"
    }
}
