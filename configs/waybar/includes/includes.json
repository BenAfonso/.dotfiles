    "wlr/taskbar": {
        "icon-size": 16,
        "icon-size-multiplier": 1.6
    },
    "tray": {
        "icon-size": 16,
        "icon-size-multiplier": 1.6
    },
    "privacy": {
        "icon-size": 10,
        "icon-size-multiplier": 1
    },
    "wlr/taskbar#windows": {
        "icon-size": 16,
        "icon-size-multiplier": 1.6
    },
    "image#wallpaper": {
        "size": 30,
        "icon-size-multiplier": 3
    },
    "position": "top",
    "custom/tempo": {
        "exec": "/home/ben/.dotfiles/configs/waybar/scripts/tempo_color.sh",
        "format": "{0}",
        "rotate": 0,
        "interval": 86400,
        "tooltip": true,
        "signal": 20
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "rotate": 0,
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb81\udeca"
        },
        "justify": "center",
        "tooltip": "true",
        "tooltip-format-activated": "<span foreground='#98c379'>\udb80\udd76 Caffeine Mode Active</span>\nPrevents system from going to sleep",
        "tooltip-format-deactivated": "<span foreground='#e06c75'>\udb81\udeca Caffeine Mode Inactive</span>\nSystem will follow normal power settings"
    },
    "custom/keepass": {
        "format": "\udb85\udd74",
        "rotate": 0,
        "on-click": "/home/ben/.dotfiles/configs/waybar/scripts/toggle-keepass.sh"
    },
    "custom/obs": {
        "format": "\uf03d ",
        "rotate": 0,
        "on-click": "/home/ben/.dotfiles/configs/waybar/scripts/toggle-obs.sh"
    }
}