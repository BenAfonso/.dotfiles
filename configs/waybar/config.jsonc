//   --// waybar config generated by old the wbarconfgen script //--   //
{
    // sourced from header module //
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "spacing": -20,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*", 
        "$XDG_CONFIG_HOME/waybar/includes/includes.json" 
    ],
    // positions generated based on config.ctl //
    "modules-left": [
        "group/pill#left",
        "group/pill#media"
    ],
    "group/pill#media": {
        "orientation": "inherit",
        "modules": [
            "custom/cava",
            "custom/media"
        ]
    },
    "group/pill#obs": {
        "orientation": "inherit",
        "modules": [
            "custom/obs"
        ]
    },
    "group/pill#tempo_color": {
        "orientation": "inherit",
        "modules": [
            "custom/tempo"
        ]
    },
    "group/pill#keepass": {
        "orientation": "inherit",
        "modules": [
            "custom/keepass"
        ]
    },
    "group/pill#left": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "idle_inhibitor",
            "clock"
        ]
    },
    "modules-right": [
        "group/pill#tempo_color",
        "group/pill#obs",
        "group/pill#keepass",
        "group/pill#right"
    ],
    "group/pill#right": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "pulseaudio",
            "pulseaudio#microphone",
            "tray",
            "battery",
            "custom/keybindhint",
            "custom/cliphist",
            "custom/hyprsunset",
            "custom/hyde-menu",
            "custom/power"
        ]
    },
  "custom/test": {
      "format": "<span color=\"#f53c3c\">TEST</span>",
      "on-click": "killall waybar"
  },
  "custom/media": {
      "format": "{text}",
      "exec": "$HOME/.config/waybar/scripts/mediaplayer.py",
      "return-type": "json",
      // "escape": true,
      "on-click": "hyprctl dispatch togglespecialworkspace spotify"
  },
  "custom/obs": {
      "format": "",
      "on-click": "$HOME/.config/waybar/scripts/toggle-obs.sh"
  },
  "custom/keepass": {
      "format": "󱕵",
      "on-click": "hyprctl dispatch togglespecialworkspace keepass &>/dev/null"
  }
}



