{
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "spacing": 8,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*"
    ],
    "tray": {
        "icon-size": 18,
        "spacing": 6
    },
    // positions generated based on config.ctl //
    "modules-left": [
        "group/pill#left",
        "group/pill#media"
    ],
    "group/pill#media": {
        "orientation": "inherit",
        "modules": [
            "custom/cava",
            "custom/media"
        ]
    },
    "group/pill#obs": {
        "orientation": "inherit",
        "modules": [
            "custom/obs"
        ]
    },
    "group/pill#tempo_color": {
        "orientation": "inherit",
        "modules": [
            "custom/tempo"
        ]
    },
    "group/pill#keepass": {
        "orientation": "inherit",
        "modules": [
            "custom/keepass"
        ]
    },
    "group/pill#discord": {
        "orientation": "inherit",
        "modules": [
            "custom/discord_status"
        ]
    },
    "group/pill#left": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "idle_inhibitor",
            "clock"
        ]
    },
    "modules-right": [
        "group/pill#discord",
        "group/pill#tempo_color",
        "group/pill#obs",
        "group/pill#keepass",
        "group/pill#right"
    ],
    "group/pill#right": {
        "orientation": "inherit",
        "modules": [
            "custom/audio",
            "custom/mic",
            "tray",
            "custom/keybindhint",
            "custom/cliphist",
            "custom/hyprsunset",
            "custom/power"
        ]
    }
}



